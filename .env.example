# ---------------------------------------------------------------------------
# ABM Aggregator — шаблон переменных окружения.
# Скопируйте в .env и заполните реальными значениями:
#     cp .env.example .env && chmod 600 .env
# Файл .env НИКОГДА не коммитится (см. .gitignore).
# ---------------------------------------------------------------------------

# ─── MongoDB ───────────────────────────────────────────────────────────────
# Логин/пароль root-пользователя, создаётся при первой инициализации тома.
MONGO_USER=abm_admin
MONGO_PASSWORD=CHANGE_ME_strong_password

# Имя базы данных приложения (сохраняется при миграции — не меняйте без причины)
MONGO_DB_NAME=abm_db

# URI базы. Для docker-compose значение переопределяется автоматически
# (mongodb://$MONGO_USER:$MONGO_PASSWORD@mongodb:27017) — здесь нужен только
# для локального запуска backend без docker.
MONGO_URL=mongodb://abm_admin:CHANGE_ME_strong_password@localhost:27017

# Имя docker-тома с данными. Позволяет подключить существующий том
# (например, старый abm_app_mongo_data) без переноса данных.
MONGO_VOLUME_NAME=abm_aggregator_mongo_data

# ─── Приложение ────────────────────────────────────────────────────────────
# Секрет для подписи JWT. Сгенерируйте: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Интервал опроса маркетплейсов, секунды
POLLING_INTERVAL_SECONDS=180

# ─── Маркетплейсы ──────────────────────────────────────────────────────────
OZON_API_KEY=
OZON_CLIENT_ID=

# Ссылка на XML-фид для синхронизации цен/остатков WB
WB_YML_URL=

# ─── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── Порты (публикуются только на 127.0.0.1) ────────────
# Если порт занят другим приложением на сервере — поменяйте значение.
FRONTEND_PORT=3005
BACKEND_PORT=8000

# Build-time переменные фронтенда (используются при сборке образа).
# Относительный путь работает через nginx-прокси внутри контейнера фронтенда.
VITE_API_URL=/api/v1
# Пусто → ws/wss собирается в рантайме из адреса страницы
VITE_WS_URL=
